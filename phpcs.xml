<?xml version="1.0"?>
<ruleset name="GetPayIn WooCommerce">
    <description>Coding standards for the GetPayIn WooCommerce plugin.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <config name="minimum_supported_wp_version" value="5.6"/>
    <config name="testVersion" value="7.2-"/>

    <rule ref="WordPress-Core">
        <!-- We use 4-space indentation throughout this codebase. -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="WordPress.WhiteSpace.PrecisionAlignment"/>
    </rule>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress.Security"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="paylink-woocommerce"/>
        </properties>
    </rule>
</ruleset>
